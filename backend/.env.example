PORT=3000
MONGODB_URI=
# Optional separate credentials for the devflow_test database.
MONGODB_TEST_URI=
# 32 random bytes in hexadecimal. Generate with: openssl rand -hex 32
CSRF_SECRET=
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Password recovery defaults to a local SMTP inbox such as Mailpit.
PASSWORD_RESET_ORIGIN=http://127.0.0.1:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="DevFlow <no-reply@devflow.test>"
# Set both when your SMTP provider requires authentication.
SMTP_USER=
SMTP_PASSWORD=
