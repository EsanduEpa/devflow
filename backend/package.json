{
  "name": "devflow-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import=tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run test/http.test.ts",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/database.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
