{
  "name": "devflow-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import=tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run --exclude '**/*.db.test.ts' --exclude '**/database.test.ts'",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run test/database.test.ts test/auth.db.test.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "mongoose": "^9.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
